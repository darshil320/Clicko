{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "declarationMap": true
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/src/**/*.test.ts"]
}
