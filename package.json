{
  "name": "clickco",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @clickco/api db:migrate",
    "db:seed": "pnpm --filter @clickco/api db:seed",
    "console": "pnpm --filter @clickco/admin dev",
    "api": "pnpm --filter @clickco/api start:local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
