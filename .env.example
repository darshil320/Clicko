# Every key the system reads. NO VALUES here, ever — not even test keys.
# Local values go in apps/api/.env (gitignored). Production: Doppler (ADR-0008).

# --- api core
NODE_ENV=
PORT=
DATABASE_URL=
REDIS_URL=
JWT_ACCESS_SECRET=
OTP_HASH_PEPPER=
# console (development only — prints OTPs) | dlt (after TRAI DLT approval)
SMS_ADAPTER=
# number of load-balancer hops in front of the API (0 locally)
TRUST_PROXY_HOPS=
# exact browser origins allowed to call the API, comma-separated (e.g. the ops console)
CORS_ORIGINS=
BANK_ACCOUNT_ENCRYPTION_KEY=

# --- payments
# sandbox (development/test only — fake orders, self-signed webhooks) | razorpay
PAYMENT_GATEWAY=
# signs sandbox webhooks (development/test only; a built-in default applies when unset)
SANDBOX_WEBHOOK_SECRET=
# required when PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- storage (Google Drive, Shared Drive, service account)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- messaging
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
DLT_ENTITY_ID=
SMS_PROVIDER_API_KEY=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- maps
GOOGLE_MAPS_API_KEY=

# --- observability
SENTRY_DSN=
POSTHOG_API_KEY=
