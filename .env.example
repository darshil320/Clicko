# Every key the system reads. NO VALUES here, ever — not even test keys.
# Local values go in apps/api/.env (gitignored). Production: Doppler (ADR-0008).

# --- api core
NODE_ENV=
PORT=
DATABASE_URL=
REDIS_URL=
# BullMQ queue + Redis key namespace (default clickco; REQUIRED in staging/production). QUEUE_WORKERS: on | off (off = test only)
QUEUE_PREFIX=
QUEUE_WORKERS=
# Staging/production: 32 random bytes each (`openssl rand -base64 32`); placeholder or README values
# are refused at boot (audit M1).
JWT_ACCESS_SECRET=
OTP_HASH_PEPPER=
# Table owner for migrations only (audit M4); DATABASE_URL is then the clickco_app login role.
MIGRATION_DATABASE_URL=
# on = mount the /dev/* routes (ops console helpers). Development + a localhost database only (audit L5).
DEV_TOOLS=
# AES-256-GCM key for staff TOTP secrets at rest: 32 random bytes, base64 (`openssl rand -base64 32`).
# REQUIRED in staging/production; development/test fall back to a fixed public dev key (ADR-0025).
STAFF_TOTP_KEY=
# console (development only — prints OTPs) | dlt (after TRAI DLT approval)
SMS_ADAPTER=
# number of load-balancer hops in front of the API (0 locally)
TRUST_PROXY_HOPS=
# exact browser origins allowed to call the API, comma-separated (local: the admin panel on
# http://localhost:3001, Expo web on http://localhost:8081)
CORS_ORIGINS=
# photographer bank account numbers at rest (audit M4): 32 random bytes, base64
# (`openssl rand -base64 32`), never the same as STAFF_TOTP_KEY. Required in staging/production.
# Rotation: move the old key to BANK_ACCOUNT_KEY_PREVIOUS as `<version>:<key>` and raise the version.
BANK_ACCOUNT_KEY=
BANK_ACCOUNT_KEY_VERSION=
BANK_ACCOUNT_KEY_PREVIOUS=

# --- payments
# sandbox (development/test only — fake orders, self-signed webhooks) | razorpay
PAYMENT_GATEWAY=
# signs sandbox webhooks — REQUIRED with the sandbox in development: 32+ random characters,
# e.g. `openssl rand -hex 32` (no built-in default; audit L4)
SANDBOX_WEBHOOK_SECRET=
# required when PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- storage (ADR-0014). local = this machine's disk (development/test only) | drive (Shared Drive, PLAN B10)
STORAGE_ADAPTER=
# local adapter: root dir (default ./.storage), size cap in bytes (default 50 GiB), optional rolling-24h upload cap
STORAGE_LOCAL_ROOT=
STORAGE_LOCAL_LIMIT_BYTES=
STORAGE_DAILY_UPLOAD_LIMIT_BYTES=
# Google Drive (Shared Drive, service account)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# RAW -> JPEG export: darktable (deployed worker image) | passthrough (development/test placeholders only)
JPEG_EXPORT_ADAPTER=
DARKTABLE_CLI_PATH=

# --- messaging
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
DLT_ENTITY_ID=
SMS_PROVIDER_API_KEY=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- maps
GOOGLE_MAPS_API_KEY=

# --- observability
SENTRY_DSN=
POSTHOG_API_KEY=
