{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/config/**",
      "/packages/contracts/**",
      "/packages/utils/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/.dockerignore",
      "!/apps/api/**/*.md",
      "!/apps/api/railway.worker.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "node dist/infra/db/migrate.js",
    "preDeployTimeoutSeconds": 600,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
