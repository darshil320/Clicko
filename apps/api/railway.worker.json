{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile.worker",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/config/**",
      "/packages/contracts/**",
      "/packages/utils/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/.dockerignore",
      "!/apps/api/**/*.md",
      "!/apps/api/railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 180,
    "limitOverride": {
      "containers": {
        "cpu": 2,
        "memoryBytes": 8589934592
      }
    }
  }
}
