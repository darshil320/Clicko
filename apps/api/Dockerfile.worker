# syntax=docker/dockerfile:1
#
# Clickco media worker image (audit H1, ADR-0027 D6a): the same build as the API, plus
# darktable-cli, running `node dist/worker.js` — the media-export queue and nothing else.
# darktable parses untrusted RAW files, so this container must be hardened: see
# apps/api/CLAUDE.md "Media worker" and docs/DEPLOY.md "Media worker hardening" for which items
# this image covers and which are platform settings.
#
# Build from the repository root:
#   docker build -f apps/api/Dockerfile.worker -t clickco-media-worker .
# Railway settings: apps/api/railway.worker.json.
#
# Keep the first two stages identical to Dockerfile.

ARG NODE_IMAGE=node:22.23.4-trixie-slim

# ── 1. Prune the workspace to @clickco/api and the packages it depends on ─────────────────────
FROM ${NODE_IMAGE} AS prune
WORKDIR /repo
COPY . .
RUN npx --yes turbo@2.11.10 prune @clickco/api --docker

# ── 2. Install from the frozen lockfile, build, and collect production dependencies ───────────
FROM ${NODE_IMAGE} AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo
COPY --from=prune /repo/out/json/ ./
RUN pnpm install --frozen-lockfile
COPY --from=prune /repo/out/full/ ./
RUN pnpm exec turbo run build --filter=@clickco/api \
 && pnpm --filter @clickco/api deploy --prod --legacy /out

# ── 3. Runtime: Node 22 + darktable-cli, production dependencies and dist/ only, non-root ─────
FROM ${NODE_IMAGE} AS runtime
# darktable ≥ 4.6 is required (darktable-cli.adapter.ts; ADR-0014 D4): Debian 13 ships 5.x.
# tini is PID 1: it forwards SIGTERM to Node and reaps darktable's child processes.
RUN apt-get update \
 && apt-get install -y --no-install-recommends darktable tini \
 && rm -rf /var/lib/apt/lists/*
RUN version="$(dpkg-query -W -f='${Version}' darktable)" \
 && dpkg --compare-versions "$version" ge 4.6 \
 || { echo "darktable 4.6 or newer is required, got $version" >&2; exit 1; }
# No setuid/setgid binaries: a compromised non-root process has nothing to escalate through
# (the image-side half of no-new-privileges, which Railway cannot set; docs/DEPLOY.md).
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +
ENV NODE_ENV=production \
    PORT=4000 \
    MEDIA_WORKER_ISOLATED=true \
    JPEG_EXPORT_ADAPTER=darktable
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
COPY --from=build /repo/apps/api/dist ./dist
COPY --chmod=0755 apps/api/docker/entrypoint.sh /usr/local/bin/clickco-entrypoint
USER node
# No HTTP server and no healthcheck: the worker only consumes the media-export queue.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/clickco-entrypoint"]
CMD ["node", "dist/worker.js"]
