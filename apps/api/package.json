    "@nestjs/throttler": "6.7.1",
    "jose": "6.2.13",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clickco/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
